# Copy this file to .env (for local `netlify dev`) or set these as
# environment variables in Netlify: Site settings → Environment variables.

# Required. Protects /admin. Use a long, random passphrase — this is the
# only thing standing between the public internet and your order database.
ADMIN_PASSWORD=

# Optional. Enables order-status emails to customers via Resend
# (https://resend.com — free tier, no card required). If either of these
# is unset, email sending is silently skipped and the rest of the site
# works normally.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
